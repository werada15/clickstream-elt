# Local credentials and machine-specific settings
.env
.env.*
!.env.example
/garage/garage.toml

# Virtual environments and Python/Jupyter caches
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Input dataset and generated pipeline data
/data/*
!/data/source/
/data/source/*
