/data/batches/
/data/tmp/
/data/analytics/

# Garage persistence is local state, not project source
/garage/data/*
!/garage/data/.gitkeep
/garage/meta/*
!/garage/meta/.gitkeep

# Local reports, editor files, and course handouts
/RESULTS/
.vscode/
*.docx
*.log
